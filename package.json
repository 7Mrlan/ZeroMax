{
  "name": "zero",
  "version": "2.6.6",
  "private": true,
  "author": "anotherwhy technologies",
  "homepage": "https://anotherwhy.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/indranilbhuin/zero"
  },
  "scripts": {
    "android": "react-native run-android",
    "android:release": "cd android && ./gradlew bundleRelease",
    "android:release:apk": "cd android && ./gradlew assembleRelease",
    "android:clean": "cd android && rm -rf app/.cxx app/build build && ./gradlew clean",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.js",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:migration": "jest --runInBand src/backend/migrations/__tests__",
    "test:export": "jest --runInBand src/backend/__tests__/upgrader.test.ts src/backend/import/__tests__ src/backend/export/__tests__",
    "security:secrets": "node scripts/secret-scan.js",
    "audit:high": "pnpm audit --prod --audit-level high",
    "performance:validate": "node scripts/validate-performance-report.js",
    "licenses:generate": "node scripts/generate-license-attribution.js",
    "android:artifact:check": "node scripts/check-android-artifact.js",
    "release:identity:check": "node scripts/check-release-identity.js",
    "e2e:contract:check": "node scripts/check-e2e-contract.js",
    "commitlint:range": "commitlint --from=HEAD~1 --to=HEAD",
    "typecheck": "tsc --strict",
    "version:set": "node scripts/bump-version.js",
    "commit": "cz",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "ios:contract:check": "node scripts/check-ios-native-contract.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@nozbe/simdjson": "^3.9.4",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-documents/picker": "12.0.2",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "@reduxjs/toolkit": "2.13.0",
    "@shopify/flash-list": "2.3.3",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.6",
    "lucide-react-native": "1.28.0",
    "nanoid": "6.0.0",
    "react": "19.3.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.87.1",
    "react-native-actions-sheet": "^10.1.2",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-localize": "^3.7.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.29.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/codegen": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/gradle-plugin": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^30.0.0",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "babel-jest": "30.3.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "globals": "17.13.0",
    "hermes-compiler": "250829098.0.17",
    "husky": "^9.1.7",
    "jest": "30.3.0",
    "lint-staged": "^16.1.2",
    "prettier": "3.9.6",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">= 22.13.0"
  },
  "//dependencyNotes": {
    "eslint": "Pinned to ^9: eslint-plugin-react-hooks, eslint-plugin-react and @babel/eslint-parser all cap their peer range at 9, and ESLint 10 dropped .eslintrc support. See eslint.config.js.",
    "jest": "Pinned exactly to 30.3.0. Bumping to 30.4.x leaves jest-mock behind react-native's own jest chain and every suite dies with 'clearMocksOnScope is not a function'. Re-test the full suite before changing.",
    "typescript": "TypeScript 7.0.2 is the source-of-truth compiler. ESLint uses Babel syntax parsing because typescript-eslint 8.71.1 rejects TS7; typecheck is the semantic gate.",
    "@babel/*": "RN 0.87.1 keeps Babel 7.29.x; legacy decorators remain explicit and Jest uses the RN default transform profile for Watermelon models.",
    "react-native-reanimated": "Pinned 4.7.1 with Worklets 0.13.0 for RN 0.87.1; pnpm override prevents ActionSheet from installing a second Worklets runtime.",
    "react-native-gesture-handler": "v3.3.0 is the RN 0.87 compatible line.",
    "lucide-react-native": "v1.x ships an .mjs bundle the RN jest preset resolves but jest cannot parse; jest.config.js maps it to the CJS build. All 334 icon imports in IconRegistry.ts were verified present in 1.28."
  },
  "packageManager": "pnpm@11.19.0",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
